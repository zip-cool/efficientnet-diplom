{
  "dataset_dir": "architectural_diploma/data/balanced_1500_per_class_split",
  "results_dir": "architectural_diploma/results/experiments",
  "summary_csv": "architectural_diploma/results/tables/experiments_summary.csv",
  "epoch_values": [5, 10, 20, 40, 60, 80, 100],
  "num_classes": 3,
  "batch_size": 32,
  "max_epochs": 20,
  "learning_rate": 0.001,
  "optimizer": "adam",
  "loss": "categorical_crossentropy",
  "metric": "accuracy",
  "random_seed": 42,
  "dropout_rate": 0.2,
  "early_stopping": {
    "monitor": "val_loss",
    "patience": 5,
    "restore_best_weights": true
  },
  "reduce_lr_on_plateau": {
    "enabled": true,
    "monitor": "val_loss",
    "factor": 0.5,
    "patience": 2,
    "min_lr": 0.000001
  },
  "augmentation": {
    "enabled": false
  }
}
